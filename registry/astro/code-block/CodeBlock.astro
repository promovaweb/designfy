---
/**
 * CodeBlock: a code sample with its file name, language and copy button.
 *
 * Receives plain text through `code` or pre-highlighted HTML through `html`;
 * there is no highlighter inside the component. The block scrolls inside its
 * own box, so a long command never widens the page. Lines listed in
 * `lineHighlights` get a tinted band.
 *
 * Slots: none.
 * Motion: the copy button swaps to a check for 1.5 s and a polite status
 * announces the copy; the click is handled by an idempotent inline script.
 *
 * Catalog: code-block
 */
interface Props {
  /** Code in plain text; it is escaped by Astro and split per line for the highlights. */
  code?: string;
  /** Pre-highlighted HTML for the code element. Takes precedence over `code`. */
  html?: string;
  /** Language shown in the header when there is no file name. */
  language?: string;
  /** File name or path shown in the header. */
  fileName?: string;
  /** Label of the copy button. Default "Copy". */
  copyLabel?: string;
  /** Label shown after copying. Default "Copied". */
  copiedLabel?: string;
  /** Sentence read by screen readers after copying. */
  copiedAnnouncement?: string;
  /** Lines to mark, counted from 1. */
  lineHighlights?: number[];
  class?: string;
}

const {
  code,
  html,
  language,
  fileName,
  copyLabel = "Copy",
  copiedLabel = "Copied",
  copiedAnnouncement = "Code copied to the clipboard.",
  lineHighlights,
  class: className,
} = Astro.props;

const lines = (code ?? "").split("\n");
const marked = new Set(lineHighlights ?? []);
---

<figure data-df-code class:list={["group relative min-w-0 overflow-hidden rounded-lg border border-border bg-muted/40", className]}>
  <figcaption class="flex min-h-11 items-center justify-between gap-3 border-b border-border px-4 py-1.5">
    <span class="min-w-0 truncate font-mono text-xs text-muted-foreground">{fileName ?? language}</span>
    <span class="flex shrink-0 items-center gap-2">
      <span aria-live="polite" role="status" data-df-copy-status data-announce={copiedAnnouncement} class="sr-only"></span>
      <button
        type="button"
        data-df-copy
        data-copy-label={copyLabel}
        data-copied-label={copiedLabel}
        class="df-press group inline-flex min-h-11 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-muted-foreground transition-colors duration-(--duration-fast) hover:bg-muted hover:text-foreground sm:min-h-8"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5 group-data-[copied]:hidden"
        >
          <rect width="12" height="12" x="8" y="8" rx="2" />
          <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden size-3.5 text-success group-data-[copied]:block"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span data-df-copy-label>{copyLabel}</span>
      </button>
    </span>
  </figcaption>
  <div class="overflow-x-auto overscroll-x-contain">
    <pre data-df-own class="min-w-full px-4 py-4 font-mono text-sm leading-relaxed"><code data-df-own>{
      html ? (
        <Fragment set:html={html} />
      ) : (
        lines.map((line, index) => (
          <span
            class:list={[
              "block",
              marked.has(index + 1) && "-mx-4 border-l-2 border-primary/60 bg-primary/10 px-4",
            ]}
          >{line === "" ? "\u00a0" : line}</span>
        ))
      )
    }</code></pre>
  </div>
</figure>

<script>
  // Copies the code of the block and confirms it for 1.5 s.
  function initCodeBlocks() {
    document.querySelectorAll<HTMLButtonElement>("button[data-df-copy]").forEach((button) => {
      if (button.dataset.dfCopyReady === "true") return;
      button.dataset.dfCopyReady = "true";
      button.addEventListener("click", async () => {
        const block = button.closest("[data-df-code]");
        const code = block?.querySelector("code");
        if (!code) return;
        const text = code.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const area = document.createElement("textarea");
          area.value = text;
          area.setAttribute("readonly", "");
          document.body.append(area);
          area.select();
          document.execCommand("copy");
          area.remove();
        }
        const label = button.querySelector<HTMLElement>("[data-df-copy-label]");
        const status = block?.querySelector<HTMLElement>("[data-df-copy-status]");
        button.setAttribute("data-copied", "");
        if (label) label.textContent = button.dataset.copiedLabel ?? "Copied";
        if (status) status.textContent = status.dataset.announce ?? "";
        window.clearTimeout(Number(button.dataset.dfCopyTimer));
        const timer = window.setTimeout(() => {
          button.removeAttribute("data-copied");
          if (label) label.textContent = button.dataset.copyLabel ?? "Copy";
          if (status) status.textContent = "";
        }, 1500);
        button.dataset.dfCopyTimer = String(timer);
      });
    });
  }

  initCodeBlocks();
  document.addEventListener("astro:page-load", initCodeBlocks);
</script>
