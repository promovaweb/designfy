---
/**
 * ComparisonTable: Compares grouped features in an accessible table with localized horizontal scrolling.
 * Motion: The table reveals on scroll and highlights the active row on hover.
 * Catalog: comparison-table
 */
import { cn } from "@designfy/components/lib/cn";

type Group = {
  title: string;
  rows: Array<{ feature: string; cells: Array<string | boolean> }>;
};

interface Props {
  /** Section heading. */
  title: string;
  /** Supporting sentence. */
  lead?: string;
  /** Heading level in the page outline. */
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  /** Column headings for the options being compared. */
  options: string[];
  /** Feature groups; each row follows the options order. */
  groups: Group[];
  /** Header for the feature column. */
  featureLabel?: string;
  /** Text for included boolean cells. */
  includedLabel?: string;
  /** Text for excluded boolean cells. */
  excludedLabel?: string;
  /** Keep the header visible in the scroll region. */
  stickyHeader?: boolean;
  /** Keep the first column visible while scrolling. */
  stickyFirstColumn?: boolean;
  /** Additional classes on the root element. */
  class?: string;
}

const {
  title,
  lead,
  headingLevel = 2,
  options,
  groups,
  featureLabel = "Feature",
  includedLabel = "Included",
  excludedLabel = "Not included",
  stickyHeader = true,
  stickyFirstColumn = true,
  class: className,
} = Astro.props;
const Heading = `h${headingLevel}` as "h2";
---

<section class={cn("df-section border-t border-border", className)}>
  <div class="df-container @container">
    <header data-df-reveal="up" class="mb-10 md:mb-14">
      <Heading class="font-heading text-headline font-semibold">{title}</Heading
      >
      {
        lead && (
          <p class="mt-4 max-w-2xl text-lead text-muted-foreground">{lead}</p>
        )
      }
    </header>
    <div
      data-df-reveal="up"
      role="region"
      aria-label={title}
      tabindex={0}
      class="max-h-[36rem] overflow-auto rounded-xl border border-border"
    >
      <table class="w-full border-separate border-spacing-0 text-start text-sm">
        <caption class="sr-only">{title}</caption>
        <thead
          class={cn(
            "bg-muted text-foreground",
            stickyHeader && "sticky top-0 z-20 shadow-sm shadow-foreground/5",
          )}
        >
          <tr>
            <th
              scope="col"
              class={cn(
                "min-w-32 bg-muted px-4 py-4 text-start @md:min-w-52",
                stickyFirstColumn && "sticky start-0 z-10",
              )}>{featureLabel}</th
            >
            {
              options.map((option) => (
                <th scope="col" class="min-w-28 px-4 py-4 text-start">
                  {option}
                </th>
              ))
            }
          </tr>
        </thead>
        {
          groups.map((group) => (
            <tbody>
              <tr>
                <th
                  scope="rowgroup"
                  colspan={options.length + 1}
                  class="bg-muted px-4 py-3 text-start font-semibold"
                >
                  <span
                    class={cn(
                      "inline-block",
                      stickyFirstColumn && "sticky start-4",
                    )}
                  >
                    {group.title}
                  </span>
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr class="group hover:bg-muted/60">
                  <th
                    scope="row"
                    class={cn(
                      "border-t border-border bg-background px-4 py-4 text-start font-medium group-hover:bg-muted",
                      stickyFirstColumn && "sticky start-0 z-10",
                    )}
                  >
                    {row.feature}
                  </th>
                  {options.map((_, index) => {
                    const cell = row.cells[index];
                    return (
                      <td class="border-t border-border px-4 py-4 text-muted-foreground">
                        {typeof cell === "boolean"
                          ? cell
                            ? includedLabel
                            : excludedLabel
                          : cell}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>
  </div>
</section>
