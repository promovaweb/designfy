---
/** Explains a feature with paragraphs, a checklist and a footnote. Uses theme motion with a static reduced-motion state. */
import { cn } from "@designfy/components/lib/cn";

interface Props {
  /** Heading text. */
  title: string;
  /** Heading level in the surrounding document. */
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  /** Optional short label. */
  label?: string;
  /** Body paragraphs. */
  paragraphs: string[];
  /** Optional check list. */
  checks?: string[];
  /** Note after the list. */
  footnote?: string;
  /** Span two rows inside DetailCardGrid. */
  tall?: boolean;
  /** Surface treatment. */
  variant?: "neutral" | "tinted";
  /** Additional root classes. */
  class?: string;
}

const {
  title,
  headingLevel = 2,
  label,
  paragraphs,
  checks,
  footnote,
  tall,
  variant = "neutral",
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as "h2";
---

<article
  data-tall={tall || undefined}
  data-df-reveal="up"
  class={cn(
    "flex min-w-0 flex-col items-start gap-4 rounded-2xl border p-6 sm:p-8",
    variant === "tinted"
      ? "border-primary/25 bg-primary/5"
      : "border-border bg-card text-card-foreground",
    className,
  )}
>
  {
    Astro.slots.has("icon") && (
      <span
        aria-hidden="true"
        class="grid size-11 place-items-center rounded-xl bg-primary/10 text-primary [&_svg]:size-5"
      >
        <slot name="icon" />
      </span>
    )
  }
  {label && <span class="text-sm font-semibold text-primary">{label}</span>}
  <Heading class="font-heading text-title font-semibold tracking-tight"
    >{title}</Heading
  >
  {paragraphs.map((text, i) => <p class="leading-relaxed">{text}</p>)}
  {
    Boolean(checks?.length) && (
      <ul role="list" class="space-y-2">
        {checks?.map((text, i) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-primary">
              ✓
            </span>
            {text}
          </li>
        ))}
      </ul>
    )
  }
  {
    footnote && (
      <p class="mt-auto pt-2 text-sm text-muted-foreground">{footnote}</p>
    )
  }
</article>
