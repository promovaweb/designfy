---
/** Pairs criteria for a good fit with criteria for a poor fit. Uses theme motion with a static reduced-motion state. */
import { cn } from "@designfy/components/lib/cn";

type Criteria = { title: string; items: string[] };
interface Props {
  /** Heading text. */
  title: string;
  /** Heading level in the surrounding document. */
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  /** Criteria for each side, with explicit group headings. */
  fits: Criteria;
  /** Criteria that indicate a poor fit. */
  excludes: Criteria;
  /** Optional note below both cards. */
  note?: string;
  /** Additional root classes. */
  class?: string;
}

const {
  title,
  headingLevel = 2,
  fits,
  excludes,
  note,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as "h2";
const Subheading = `h${Math.min(6, headingLevel + 1)}` as "h3";
---

<section class={cn("@container space-y-6", className)}>
  <Heading class="font-heading text-title font-semibold tracking-tight"
    >{title}</Heading
  >
  <div data-df-stagger class="grid gap-4 @2xl:grid-cols-2">
    {
      [fits, excludes].map((group, i) => (
        <article
          data-df-reveal="up"
          class={cn(
            "rounded-2xl border bg-card p-6 text-card-foreground",
            i === 0 ? "border-primary/50" : "border-border",
          )}
        >
          <Subheading class="font-heading text-xl font-semibold">
            {group.title}
          </Subheading>
          <ul role="list" class="mt-5 space-y-3">
            {group.items.map((item, j) => (
              <li class="flex gap-3">
                <span
                  aria-hidden="true"
                  class={i === 0 ? "text-primary" : "text-muted-foreground"}
                >
                  {i === 0 ? "✓" : "×"}
                </span>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
  {note && <p class="df-measure text-muted-foreground">{note}</p>}
</section>
