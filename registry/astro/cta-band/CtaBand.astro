---
/**
 * CtaBand: Repeats the primary action in a full-width or inset band with an optional form.
 * Slots or React nodes: form, background.
 * Motion: The band reveals as one unit. A supplied background can add a slow loop.
 * Catalog: cta-band
 */
import { cn } from "@designfy/components/lib/cn";

type Action = { label: string; href: string };

interface Props {
  /** Section heading. */
  title: string;
  /** Supporting sentence. */
  lead?: string;
  /** Heading level in the page outline. */
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  /** Main action link. */
  action?: Action;
  /** Full-width band or inset composition. */
  variant?: "full" | "inset";
  /** Additional classes on the root element. */
  class?: string;
}

const {
  title,
  lead,
  headingLevel = 2,
  action,
  variant = "inset",
  class: className,
} = Astro.props;
const Heading = `h${headingLevel}` as "h2";
---

<section
  class={cn(
    variant === "inset" ? "df-section df-container" : "bg-primary/10",
    className,
  )}
>
  <div
    data-df-reveal="fade"
    class={cn(
      "relative isolate overflow-clip",
      variant === "inset"
        ? "rounded-2xl bg-primary/10 p-6 sm:p-10 lg:p-14"
        : "df-section df-container",
    )}
  >
    {
      Astro.slots.has("background") && (
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-10"
        >
          <slot name="background" />
        </div>
      )
    }
    <div class="grid min-w-0 items-end gap-6 md:grid-cols-[minmax(0,1fr)_auto]">
      <div class="min-w-0">
        <Heading class="font-heading text-headline font-semibold"
          >{title}</Heading
        >
        {
          lead && (
            <p class="mt-4 max-w-2xl text-lead text-muted-foreground">{lead}</p>
          )
        }
      </div>
      {
        action && (
          <a
            href={action.href}
            class="df-press inline-flex min-h-12 min-w-11 items-center justify-center rounded-lg bg-primary px-5 py-2 text-center text-sm font-semibold text-primary-foreground hover:bg-primary/90 w-full md:w-auto"
          >
            {action.label}
          </a>
        )
      }
    </div>
    {
      Astro.slots.has("form") && (
        <div class="mt-6 max-w-xl">
          <slot name="form" />
        </div>
      )
    }
  </div>
</section>
