---
/**
 * VideoEmbed: plays a hosted video without loading the player until the person
 * asks for it.
 *
 * The facade is a poster and one button named with the video title. On click
 * the frame becomes the player: an iframe on the privacy-enhanced YouTube
 * domain, the Vimeo player, or a native <video> for a self-hosted file. The
 * frame keeps its aspect ratio at every width and the title travels in the
 * iframe `title` attribute.
 *
 * Slots: none.
 * Motion: the play button scales on hover and press; the player fades in over
 * the poster. The click is handled by an idempotent inline script.
 *
 * Catalog: video-embed
 */
interface Props {
  /** Name of the video; it names the button and the player frame. */
  title: string;
  /** Host of the video. Default "youtube". */
  provider?: "youtube" | "vimeo" | "native";
  /** Video ID on YouTube or Vimeo. Required for those providers. */
  videoId?: string;
  /** Source of the file, for the native provider. */
  src?: string;
  /** Poster image shown before the click. */
  poster?: string;
  /** Describes the poster; empty when the title already says it. */
  posterAlt?: string;
  /** Aspect ratio of the frame. Default "16/9". */
  aspect?: "16/9" | "4/3" | "1/1" | "21/9";
  /** Caption under the frame. */
  caption?: string;
  /** Link to the transcript of the video. */
  transcript?: { label: string; href: string };
  class?: string;
}

const {
  title,
  provider = "youtube",
  videoId,
  src,
  poster,
  posterAlt = "",
  aspect = "16/9",
  caption,
  transcript,
  class: className,
} = Astro.props;

const aspectClass = {
  "16/9": "aspect-[16/9]",
  "4/3": "aspect-[4/3]",
  "1/1": "aspect-square",
  "21/9": "aspect-[21/9]",
}[aspect];
---

<figure
  data-df-video
  data-provider={provider}
  data-video-id={videoId}
  data-src={src}
  data-title={title}
  data-poster={poster}
  class:list={["not-prose flex min-w-0 flex-col", className]}
>
  <div data-df-video-shell class:list={["relative overflow-hidden rounded-xl border border-border bg-muted", aspectClass]}>
    <button
      type="button"
      data-df-video-play
      aria-label={title}
      class="group absolute inset-0 flex size-full items-center justify-center"
    >
      {
        poster ? (
          <img src={poster} alt={posterAlt} loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
        ) : (
          <span aria-hidden="true" class="absolute inset-0 bg-foreground/5" />
        )
      }
      <span class="relative flex size-16 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg transition-transform duration-(--duration-base) ease-out-quart group-hover:scale-105 group-active:scale-95 motion-reduce:transition-none motion-reduce:group-hover:scale-100">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-6 translate-x-0.5">
          <path d="M8 5.5v13a1 1 0 0 0 1.54.84l10-6.5a1 1 0 0 0 0-1.68l-10-6.5A1 1 0 0 0 8 5.5Z" />
        </svg>
      </span>
    </button>
  </div>

  {
    (title || caption || transcript) && (
      <figcaption class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-muted-foreground">
        <span class="min-w-0 text-pretty font-medium text-foreground">{title}</span>
        {caption && <span class="min-w-0 text-pretty">{caption}</span>}
        {transcript && (
          <a href={transcript.href} class="df-underline inline-flex min-h-11 items-center text-sm font-medium text-foreground sm:min-h-6">
            {transcript.label}
          </a>
        )}
      </figcaption>
    )
  }
</figure>

<script>
  // Swaps the facade for the player only after the click.
  function initVideos() {
    document.querySelectorAll<HTMLButtonElement>("button[data-df-video-play]").forEach((button) => {
      if (button.dataset.dfVideoReady === "true") return;
      button.dataset.dfVideoReady = "true";
      button.addEventListener("click", () => {
        const figure = button.closest<HTMLElement>("[data-df-video]");
        const shell = figure?.querySelector<HTMLElement>("[data-df-video-shell]");
        if (!figure || !shell) return;
        const { provider = "youtube", videoId, src, title = "", poster } = figure.dataset;
        let media: HTMLIFrameElement | HTMLVideoElement;
        if (provider === "native") {
          const video = document.createElement("video");
          video.src = src ?? "";
          if (poster) video.poster = poster;
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          media = video;
        } else {
          const iframe = document.createElement("iframe");
          iframe.src =
            provider === "vimeo"
              ? `https://player.vimeo.com/video/${videoId ?? ""}?autoplay=1`
              : `https://www.youtube-nocookie.com/embed/${videoId ?? ""}?autoplay=1&rel=0`;
          iframe.title = title;
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;
          media = iframe;
        }
        media.className = "size-full animate-df-fade-in object-cover";
        shell.replaceChildren(media);
      });
    });
  }

  initVideos();
  document.addEventListener("astro:page-load", initVideos);
</script>
