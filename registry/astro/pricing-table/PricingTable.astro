---
/**
 * PricingTable: Compares plan cards with a billing period switch and an optional comparison below.
 * Slots or React nodes: comparison.
 * Motion: The displayed price rolls into position when the billing period changes.
 * Catalog: pricing-table
 */
import { cn } from "@designfy/components/lib/cn";

type Action = { label: string; href: string };
type Plan = {
  name: string;
  description?: string;
  monthly: string;
  yearly: string;
  features: Array<{ label: string; included: boolean }>;
  action: Action;
  recommended?: boolean;
};

type SingleOffer = {
  label: string;
  currency: string;
  price: string;
  period: string;
  installment?: string;
  action: Action;
  finePrint?: string;
  included: string[];
};

type PricingMode =
  | { variant: "single"; offer: SingleOffer; plans?: never; id?: string }
  | { variant?: "plans"; offer?: never; plans: Plan[]; id: string };

type Props = PricingMode & {
  /** Section heading. */
  title: string;
  /** Supporting sentence. */
  lead?: string;
  /** Heading level in the page outline. */
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  /** Label for the monthly period. */
  monthlyLabel?: string;
  /** Label for the yearly period. */
  yearlyLabel?: string;
  /** Accessible name of the billing group. */
  billingLabel?: string;
  /** Text next to included features. */
  includedLabel?: string;
  /** Text next to excluded features. */
  excludedLabel?: string;
  /** Text identifying the highlighted plan. */
  recommendedLabel?: string;
  /** Initially selected billing period. */
  initialPeriod?: "monthly" | "yearly";
  /** Additional classes on the root element. */
  class?: string;
};

const {
  title,
  lead,
  headingLevel = 2,
  id,
  plans = [],
  variant,
  offer,
  monthlyLabel = "Monthly",
  yearlyLabel = "Yearly",
  billingLabel = "Billing period",
  includedLabel = "Included",
  excludedLabel = "Not included",
  recommendedLabel = "Recommended",
  initialPeriod = "monthly",
  class: className,
} = Astro.props;
const Heading = `h${headingLevel}` as "h2";
const ItemHeading = `h${Math.min(6, headingLevel + 1)}` as "h3";
const entries = [...plans].sort(
  (current, next) =>
    Number(Boolean(next.recommended)) - Number(Boolean(current.recommended)),
);
---

<section
  data-site-pricing-table
  data-period={initialPeriod}
  class={cn("df-section", className)}
>
  <div class="df-container">
    <header data-df-reveal="up" class="mb-10 md:mb-14">
      <Heading class="font-heading text-headline font-semibold">{title}</Heading
      >
      {
        lead && (
          <p class="mt-4 max-w-2xl text-lead text-muted-foreground">{lead}</p>
        )
      }
    </header>
    {
      variant === "single" && offer ? (
        <article
          data-df-reveal="up"
          class="@container rounded-2xl border border-border bg-card p-6 text-card-foreground sm:p-10"
        >
          <div class="grid gap-6 @2xl:grid-cols-2">
            <div class="grid justify-items-start gap-4">
              <ItemHeading class="text-title font-semibold">
                {offer.label}
              </ItemHeading>
              <p class="flex flex-wrap items-baseline gap-2">
                <>
                  <span>{offer.currency}</span>
                  <strong class="font-heading text-headline tabular-nums">
                    {offer.price}
                  </strong>
                  <span>{offer.period}</span>
                </>
              </p>
              {offer.installment && (
                <p class="text-muted-foreground">{offer.installment}</p>
              )}
              <a
                href={offer.action.href}
                class="df-press inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-3 font-semibold text-primary-foreground hover:bg-primary/90"
              >
                {offer.action.label}
              </a>
              {offer.finePrint && (
                <p class="text-sm text-muted-foreground">{offer.finePrint}</p>
              )}
            </div>
            <ul
              role="list"
              aria-label={includedLabel}
              class="grid content-center gap-3 border-t border-border pt-6 @2xl:border-s @2xl:border-t-0 @2xl:ps-8 @2xl:pt-0"
            >
              {offer.included.map((item, i) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="text-primary">
                    ✓
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ) : (
        <>
          <fieldset hidden class="mb-8 min-w-0">
            <legend class="sr-only">{billingLabel}</legend>
            <div class="inline-flex max-w-full flex-wrap rounded-xl border border-border bg-muted p-1">
              {(["monthly", "yearly"] as const).map((period) => (
                <label class="df-press relative flex min-h-11 cursor-pointer items-center rounded-lg px-4 py-2 text-sm font-semibold text-muted-foreground has-checked:bg-primary has-checked:text-primary-foreground has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ring">
                  <input
                    type="radio"
                    name={id + "-billing"}
                    value={period}
                    checked={initialPeriod === period}
                    class="sr-only"
                  />
                  {period === "monthly" ? monthlyLabel : yearlyLabel}
                </label>
              ))}
            </div>
          </fieldset>
          <ul
            data-df-stagger
            class="grid gap-4 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(min(100%,14rem),1fr))]"
          >
            {entries.map((plan) => (
              <li
                data-df-reveal="up"
                class={cn(
                  "group relative flex min-w-0 flex-col rounded-2xl border border-border bg-card p-6 text-card-foreground",
                  plan.recommended && "border-primary/65 bg-primary/5",
                )}
              >
                {plan.recommended && (
                  <span
                    aria-hidden="true"
                    data-df-loop
                    class="pointer-events-none absolute inset-x-6 top-0 h-px bg-linear-to-r from-primary/0 via-primary/65 to-primary/0 bg-size-[200%_100%] motion-safe:animate-df-pan group-hover:[animation-play-state:paused] group-focus-within:[animation-play-state:paused]"
                  />
                )}
                <ItemHeading class="text-title font-semibold">
                  {plan.name}
                </ItemHeading>
                {plan.recommended && (
                  <p class="mt-1 text-sm font-semibold text-primary">
                    {recommendedLabel}
                  </p>
                )}
                <div
                  aria-live="polite"
                  class="mt-6 min-w-0 overflow-hidden py-1"
                >
                  {(["monthly", "yearly"] as const).map((period) => (
                    <div
                      data-price={period}
                      hidden={initialPeriod !== period}
                      class="min-w-0 break-words [&[hidden]]:hidden!"
                    >
                      <span class="font-heading text-headline font-semibold tabular-nums">
                        {plan[period]}
                      </span>
                      <span class="ms-2 text-sm text-muted-foreground">
                        {period === "monthly" ? monthlyLabel : yearlyLabel}
                      </span>
                    </div>
                  ))}
                </div>
                {plan.description && (
                  <p class="mt-2 text-sm text-muted-foreground">
                    {plan.description}
                  </p>
                )}
                <ul class="my-6 grid gap-3 border-t border-border pt-6 text-sm">
                  {plan.features.map((feature) => (
                    <li
                      class={cn(
                        "flex min-w-0 items-start gap-2 break-words",
                        !feature.included && "text-muted-foreground",
                      )}
                    >
                      <span class="shrink-0 text-primary" aria-hidden="true">
                        {feature.included ? "+" : "−"}
                      </span>
                      <span>
                        <span class="sr-only">
                          {feature.included ? includedLabel : excludedLabel}
                          :{" "}
                        </span>
                        {feature.label}
                      </span>
                    </li>
                  ))}
                </ul>
                <a
                  href={plan.action.href}
                  class={cn(
                    "mt-auto",
                    plan.recommended
                      ? "df-press inline-flex min-h-12 min-w-11 items-center justify-center rounded-lg bg-primary px-5 py-2 text-center text-sm font-semibold text-primary-foreground hover:bg-primary/90"
                      : "df-press inline-flex min-h-12 min-w-11 items-center justify-center rounded-lg border border-border bg-background px-5 py-2 text-center text-sm font-semibold hover:bg-muted",
                  )}
                >
                  {plan.action.label}
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
    {
      Astro.slots.has("comparison") && (
        <div class="mt-10">
          <slot name="comparison" />
        </div>
      )
    }
  </div>
</section>

<script is:inline>
  (() => {
    function bind(root) {
      const abort = new AbortController();
      const switcher = root.querySelector("fieldset");
      if (!switcher) return;
      switcher.hidden = false;
      switcher.addEventListener(
        "change",
        (event) => {
          const input = event.target;
          if (!(input instanceof HTMLInputElement)) return;
          root.dataset.period = input.value;
          const reduced = matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          for (const price of root.querySelectorAll("[data-price]")) {
            price.hidden = price.dataset.price !== input.value;
            if (!price.hidden && !reduced) {
              price.getAnimations().forEach((animation) => animation.cancel());
              price.animate(
                [
                  { transform: "translateY(0.4em)", opacity: 0 },
                  { transform: "translateY(0)", opacity: 1 },
                ],
                { duration: 250, easing: "cubic-bezier(0.25, 1, 0.5, 1)" },
              );
            }
          }
        },
        { signal: abort.signal },
      );
      return () => abort.abort();
    }

    function prepare() {
      document
        .querySelectorAll("[data-site-pricing-table]:not([data-site-bound])")
        .forEach((root) => {
          root.setAttribute("data-site-bound", "");
          const dispose = bind(root);
          if (dispose)
            document.addEventListener(
              "astro:before-swap",
              () => {
                dispose();
                root.removeAttribute("data-site-bound");
              },
              { once: true },
            );
        });
    }

    prepare();
    if (
      !document.documentElement.hasAttribute("data-site-pricing-table-listener")
    ) {
      document.documentElement.setAttribute(
        "data-site-pricing-table-listener",
        "",
      );
      document.addEventListener("astro:page-load", prepare);
    }
  })();
</script>
