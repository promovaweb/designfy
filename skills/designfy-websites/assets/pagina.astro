---
/**
 * Modelo: página de site composta com itens do registro do Designfy (Astro).
 *
 * O conteúdo vem de fora (coleção, arquivo de dado). Este arquivo só monta
 * as seções na ordem do argumento. Ajuste os caminhos ao alias do projeto.
 */
import Base from "@/layouts/Base.astro";
import SiteHeader from "@/components/designfy/site-header/SiteHeader.astro";
import SiteFooter from "@/components/designfy/site-footer/SiteFooter.astro";
import Background from "@/components/designfy/background/Background.astro";
import Section from "@/components/designfy/section/Section.astro";
import HeroSplit from "@/components/designfy/hero-split/HeroSplit.astro";
import BentoGrid from "@/components/designfy/bento-grid/BentoGrid.astro";
import Steps from "@/components/designfy/steps/Steps.astro";
import PricingTable from "@/components/designfy/pricing-table/PricingTable.astro";
import Faq from "@/components/designfy/faq/Faq.astro";
import CtaBand from "@/components/designfy/cta-band/CtaBand.astro";
import { page, site } from "@/data/produto";

const action = { label: page.action.label, href: page.action.href };
---

<Base title={page.title} description={page.description}>
  <SiteHeader brand={site.brand} links={site.links} action={action} />

  <main id="conteudo">
    <HeroSplit name={site.brand.name} headline={page.hero.headline} lead={page.hero.lead} primaryAction={action} secondaryAction={page.hero.secondary}>
      <Background slot="background" preset="signal-grid" fade="radial" />
      <img slot="visual" src={page.hero.image.src} alt={page.hero.image.alt} width={page.hero.image.width} height={page.hero.image.height} fetchpriority="high" />
    </HeroSplit>

    <Section id="recursos" title={page.features.title} lead={page.features.lead}>
      <BentoGrid items={page.features.items} />
    </Section>

    <Section id="como-funciona" title={page.steps.title} tone="muted">
      <Steps items={page.steps.items} />
    </Section>

    {
      page.plans.length > 0 && (
        <Section id="precos" title={page.pricing.title} lead={page.pricing.lead} align="center">
          <PricingTable plans={page.plans} />
        </Section>
      )
    }

    <Section id="perguntas" title={page.faq.title} tone="muted" width="narrow">
      <Faq items={page.faq.items} />
    </Section>

    <CtaBand title={page.cta.title} lead={page.cta.lead} action={action}>
      <Background slot="background" preset="studio-soft-blueprint" fade="edges" />
    </CtaBand>
  </main>

  <SiteFooter brand={site.brand} columns={site.footer.columns} legal={site.footer.legal} />
</Base>
