{
  "name": "designfy-example-react-site",
  "private": true,
  "type": "module",
  "scripts": {
    "designfy:sync": "bun run ../../src/main.ts components add site-header site-footer announcement-bar hero-centered hero-media feature-grid bento-grid feature-split steps stats-band counter logo-marquee marquee testimonial pricing-table comparison-table faq cta-band newsletter-form card theme-toggle background --overwrite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4418",
    "capture": "bun run ../../src/main.ts capture run http://localhost:4418 --viewport 390x844,1440x1000 --wait 900"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5",
    "@fontsource-variable/manrope": "^5",
    "clsx": "^2",
    "lucide-react": "^1.79.0",
    "motion": "^12",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3",
    "tw-animate-css": "^1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "tailwindcss": "^4",
    "vite": "~6.4.0",
    "playwright": "1.62.0",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
