---
/** Fieldnote home page composed of installed Designfy registry sections. */
import Layout from "../Layout.astro";
import Background from "@/components/designfy/background/Background.astro";
import BentoGrid from "@/components/designfy/bento-grid/BentoGrid.astro";
import CtaBand from "@/components/designfy/cta-band/CtaBand.astro";
import Faq from "@/components/designfy/faq/Faq.astro";
import FeatureSplit from "@/components/designfy/feature-split/FeatureSplit.astro";
import HeroSplit from "@/components/designfy/hero-split/HeroSplit.astro";
import LogoMarquee from "@/components/designfy/logo-marquee/LogoMarquee.astro";
import PricingTable from "@/components/designfy/pricing-table/PricingTable.astro";
import Card from "@/components/designfy/card/Card.astro";
import StatsBand from "@/components/designfy/stats-band/StatsBand.astro";
import Steps from "@/components/designfy/steps/Steps.astro";
import Testimonial from "@/components/designfy/testimonial/Testimonial.astro";
import {
  images,
  logoNames,
  metrics,
  plans,
  plansLink,
  preview,
  questions,
  quotes,
  steps,
  tiles,
} from "../sample";
---

<Layout title="Research notes that stay connected">
  <HeroSplit
    headline="From field notes to shared decisions."
    lead="Fieldnote gives research teams one place to collect observations, connect the evidence and write a brief."
    primaryAction={preview}
    secondaryAction={plansLink}
  >
    <Background
      slot="background"
      preset="signal-grid"
      className="absolute inset-0"
      fade="bottom"
    />
    <div
      slot="visual"
      role="img"
      aria-label="Sample Fieldnote workspace showing a study with two findings"
      class="grid min-w-0 gap-5 bg-muted p-5 text-sm sm:p-8"
    >
      <div
        class="flex items-center justify-between gap-4 border-b border-border pb-4"
      >
        <div class="flex items-center gap-3">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-6 text-primary"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            ><path d="M4 5h16v14H4zm5 4h7m-7 3h7m-7 3h4"></path></svg
          >
          <span class="font-semibold">Sample workspace</span>
        </div>
        <span class="text-muted-foreground">12 notes</span>
      </div>
      <div>
        <p class="font-heading text-title font-semibold">First-use study</p>
        <p class="mt-1 text-muted-foreground">Example project · 3 sessions</p>
      </div>
      <div class="grid gap-3">
        <div class="rounded-lg bg-background p-4">
          <p class="font-semibold">Finding 01 · Setup</p>
          <div class="mt-3 h-1.5 rounded-full bg-muted">
            <div class="h-full w-3/4 rounded-full bg-primary/65"></div>
          </div>
        </div>
        <div class="rounded-lg bg-background p-4">
          <p class="font-semibold">Finding 02 · Handoff</p>
          <div class="mt-3 h-1.5 rounded-full bg-muted">
            <div class="h-full w-1/2 rounded-full bg-primary/65"></div>
          </div>
        </div>
      </div>
    </div>
  </HeroSplit>
  <LogoMarquee label="Teams in this fictional example" items={logoNames} />
  <BentoGrid
    title="Keep the evidence close"
    lead="Each part of the workspace keeps a link back to the research."
    items={tiles}
  />
  <FeatureSplit
    title="Bring each observation back to the session"
    lead="Group notes by what you observed. When someone asks for context, open the session from the note."
    images={[images.notes]}
    points={[
      "Capture the detail while it’s fresh",
      "Keep the original wording nearby",
    ]}
  />
  <FeatureSplit
    title="Give the team a brief they can use"
    lead="Share findings, source notes and the next decision in a single brief."
    images={[images.brief]}
    visualSide="start"
    action={{ label: "Walk through the example", href: "/landing/" }}
  />
  <div id="process"><Steps title="From session to brief" items={steps} /></div>
  <StatsBand title="Inside the sample workspace" items={metrics} />
  <Testimonial title="A sample account of a research review" items={quotes} />
  <PricingTable
    id="home-plans"
    title="Choose a sample plan"
    lead="Compare the workspaces and collaboration options in this example."
    {plans}
  />
  <Faq title="Questions about the sample" items={questions} variant="split" />
  <CtaBand
    title="Take a look at the workspace"
    lead="Explore the fictional study and see how the findings link to the notes."
    action={preview}
  >
    <Background
      slot="background"
      preset="left-masked-basic-grid"
      className="absolute inset-0 opacity-35"
    />
  </CtaBand>
  <div class="df-container pb-16">
    <Card
      title="Compare sample plans"
      description="See the workspace limits and sharing options side by side."
      href="/pricing/"
      reveal
    />
  </div>
</Layout>
